<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title><%= t('qes.app.confirm_title') %></title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: #faf7f5;
        color: #111;
      }

      .qes-page {
        max-width: 480px;
        margin: 0 auto;
        padding: 24px 16px 48px;
      }

      .qes-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        padding: 24px;
        text-align: center;
      }

      .qes-qr svg {
        width: 260px;
        height: 260px;
        max-width: 100%;
        height: auto;
      }

      .qes-row {
        text-align: left;
        margin: 8px 0;
        font-size: 14px;
        line-height: 1.4;
      }

      .qes-row .qes-label {
        color: #6b7280;
      }

      .qes-hash {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11px;
        word-break: break-all;
        color: #374151;
      }

      .qes-button {
        display: inline-block;
        margin: 16px 0 8px;
        padding: 12px 24px;
        border-radius: 24px;
        background: #291334;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
      }

      .qes-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 8px;
        padding: 12px 16px;
        text-align: left;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="qes-page">
      <div class="qes-card">
        <% if @session.nil? %>
          <div class="qes-error"><%= t('qes.error.unknown_token') %></div>
        <% elsif @session.expired? %>
          <div class="qes-error"><%= t('qes.error.expired_token') %></div>
        <% elsif @session.terminal? && @session.state != 'completed' %>
          <div class="qes-error"><%= t('qes.error.used_token') %></div>
        <% else %>
          <h1><%= t('qes.app.confirm_title') %></h1>
          <div class="qes-row">
            <span class="qes-label"><%= t('qes.app.confirm_document', document_name: @document_name) %></span>
          </div>
          <div class="qes-row">
            <span class="qes-label"><%= t('qes.app.confirm_signer', name: @signer_name) %></span>
          </div>
          <div class="qes-row">
            <span class="qes-label"><%= t('qes.step.expires_in', minutes: ((@expires_at - Time.current) / 60).ceil.clamp(0, 999)) %></span>
          </div>
          <div class="qes-qr">
            <%== @qr_svg %>
          </div>
          <a class="qes-button" href="<%= @custom_scheme_link %>"><%= t('qes.step.open_app') %></a>
          <div class="qes-row">
            <a href="<%= @fallback_url %>"><%= @universal_link %></a>
          </div>
        <% end %>
      </div>
    </div>
  </body>
</html>
